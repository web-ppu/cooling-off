# ================================================================
# 쿨링오프 환경변수 템플릿
# 이 파일을 복사해 .env.local 을 만들고 실제 값을 채워 주세요.
# .env.local 은 절대 커밋하지 마세요.
# ================================================================

# ── Supabase ────────────────────────────────────────────────────
# Supabase 프로젝트 대시보드 > Settings > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 서버 전용 (클라이언트에 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Web Push (알림) ──────────────────────────────────────────────
# 생성: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:your@email.com

# ── Cron (Vercel 자동 호출용) ────────────────────────────────────
# Vercel 이 /api/cron/* 라우트를 호출할 때 Authorization 헤더에
# `Bearer ${CRON_SECRET}` 을 자동으로 붙여준다. 엔드포인트에서 이 값으로 인증.
# 생성: openssl rand -hex 32  (또는 임의의 긴 랜덤 문자열)
CRON_SECRET=your-cron-secret

# ── Google OAuth ────────────────────────────────────────────────
# Google Cloud Console > APIs & Services > Credentials 에서 확인
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── App ─────────────────────────────────────────────────────────
# 로컬: http://localhost:3000 / 프로덕션: Vercel 도메인
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── iOS 단축어 (유입 캡처) ───────────────────────────────────────
# iOS 단축어를 만든 뒤 iCloud 공유 링크(https://www.icloud.com/shortcuts/...)를 넣으면
# /capture/shortcut 페이지에 [단축어 추가하기] 버튼이 노출된다.
# 비워 두면 안내 문구만 보이고 URL 직접 붙여넣기로 대체된다.
# 제작 방법: docs/engineering/capture-setup.md 참고
NEXT_PUBLIC_IOS_SHORTCUT_URL=

# ── AI 채팅 (Gemini) ────────────────────────────────────────────
# 발급: https://aistudio.google.com/app/apikey (무료 티어 충분)
# 선정 모델: Gemini 3.1 Flash-Lite — docs/engineering/model-selection.md 참고
GEMINI_API_KEY=your-gemini-api-key

# 사용할 모델 ID (비워두면 gemini-3.1-flash-lite 기본)
GEMINI_MODEL=

# ── Admin 화이트리스트 (테스트/QA 전용) ──────────────────────────
# 콤마로 구분된 이메일 목록. 등록된 사용자는 /admin 페이지 접근 가능 +
# 냉각이 끝나지 않은 본인 item 으로도 채팅 진입 가능.
# 비워 두면 admin 기능 비활성 (= 일반 사용자 정책만 적용).
# 예: ADMIN_EMAILS=eounjee@gmail.com,mmin05@example.com
ADMIN_EMAILS=
